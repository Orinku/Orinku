# Your deployed API domain: just the origin, no trailing slash and no /api.
#   Home data  -> GET {VITE_API_BASE_URL}/api
#   Top ten    -> GET {VITE_API_BASE_URL}/api/top-ten
# Example: VITE_API_BASE_URL=https://your-api-domain.com
# (Vite reads this at start-up, so restart `npm run dev` after editing.)
VITE_API_BASE_URL=http://localhost:4000
